{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "name", "types", "baseStats", "abilities", "moves", "items"],
    "properties": {
      "id": { "type": "string", "minLength": 1 },
      "name": { "type": "string", "minLength": 1 },
      "types": {
        "type": "array",
        "minItems": 1,
        "maxItems": 2,
        "items": {
          "type": "string",
          "enum": [
            "NORMAL",
            "FIRE",
            "WATER",
            "ELECTRIC",
            "GRASS",
            "ICE",
            "FIGHTING",
            "POISON",
            "GROUND",
            "FLYING",
            "PSYCHIC",
            "BUG",
            "ROCK",
            "GHOST",
            "DRAGON",
            "DARK",
            "STEEL",
            "FAIRY"
          ]
        }
      },
      "baseStats": {
        "type": "object",
        "required": ["hp", "attack", "defense", "specialAttack", "specialDefense", "speed"],
        "properties": {
          "hp": { "type": "integer", "minimum": 1 },
          "attack": { "type": "integer", "minimum": 1 },
          "defense": { "type": "integer", "minimum": 1 },
          "specialAttack": { "type": "integer", "minimum": 1 },
          "specialDefense": { "type": "integer", "minimum": 1 },
          "speed": { "type": "integer", "minimum": 1 }
        }
      },
      "abilities": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "string", "minLength": 1 }
      },
      "moves": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "string", "minLength": 1 }
      },
      "items": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "string", "minLength": 1 }
      }
    }
  }
}
